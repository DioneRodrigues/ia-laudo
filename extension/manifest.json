{
  "manifest_version": 3,
  "name": "Eden Voice Transcriber",
  "version": "0.9.5",
  "description": "Grava um ditado, transcreve e insere o texto no Eden AI.",
  "permissions": ["storage"],
  "host_permissions": ["http://10.33.0.7/*", "https://10.33.0.7/*"],
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pacs.evacenter.com/*"],
      "js": [
        "content/config.js",
        "content/logConfig.js",
        "utils/logger.js",
        "storage/logStore.js",
        "storage/audioStoreClient.js",
        "content/patientContext.js",
        "content/monitoring.js",
        "content/recorder.js",
        "content/edenEditor.js",
        "content/edenControls.js",
        "content/medicalCommandCatalog.js",
        "content/apiClient.js",
        "services/commandProcessor.generated.js",
        "services/recordingProcessor.js",
        "content/ui.js",
        "content/content.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/clinicadamama-logo.png",
        "storage/broker.html",
        "storage/player.html"
      ],
      "matches": ["https://pacs.evacenter.com/*"]
    }
  ]
}
